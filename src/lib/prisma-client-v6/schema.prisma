// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/prisma-client-v6"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  avatar       String?
  phone        String?
  bio          String?
  passwordHash String?
  status       String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  lastLoginAt  DateTime?
  role         String    @default("member") // "member" | "admin" | "owner"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings       Booking[]
  reviews        Review[]
  rentalRequests RentalRequest[]
  reservations   RentalReservation[]
}

model RentalCompany {
  id        String   @id @default(cuid())
  name      String   @default("RentHub Enterprise Rentals")
  legalName String?  @default("RentHub Co., Ltd.")
  currency  String   @default("USD")
  timezone  String   @default("Asia/Phnom_Penh")
  phone     String?  @default("+855 23 888 999")
  email     String?  @default("support@renthub.app")
  address   String?  @default("Building 42, Norodom Blvd, Phnom Penh, Cambodia")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      AssetLocation[]
  listings       AssetListing[]
  auditEvents    AssetAuditEvent[]
  rentalRequests RentalRequest[]
}

model AssetCategory {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?
  imageUrl         String?
  iconName         String?  @default("Folder")
  color            String?  @default("#10B981")
  parentId         String?
  displayOrder     Int      @default(0)
  status           String   @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "ARCHIVED"
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent   AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AssetCategory[] @relation("CategoryHierarchy")
  listings AssetListing[]
}

model AssetBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings AssetListing[]
}

model AssetLocation {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  code            String   @unique
  address         String
  city            String
  timezone        String   @default("Asia/Phnom_Penh")
  isPickupDefault Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          RentalCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  units            AssetUnit[]
  locationOptions  AssetLocationOption[]
  pickupRequests   RentalRequest[]         @relation("RequestPickupLoc")
  returnRequests   RentalRequest[]         @relation("RequestReturnLoc")
  reservations     RentalReservation[]
  fulfillmentTasks RentalFulfillmentTask[]
}

model AssetListing {
  id               String    @id @default(cuid())
  companyId        String
  code             String    @unique
  name             String
  slug             String    @unique
  categoryId       String
  brandId          String?
  model            String?
  shortDescription String
  description      String?
  specifications   String? // JSON object string: {"RAM":"16GB", "Storage":"512GB SSD"}
  trackingMode     String    @default("SERIALIZED") // "SERIALIZED" | "QUANTITY"
  conditionNote    String?
  coverImage       String
  images           String    @default("[]") // JSON array string of image URLs
  allowDelivery    Boolean   @default(true)
  deliveryFee      Float     @default(0)
  visibility       String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "UNPUBLISHED" | "ARCHIVED"
  publishedAt      DateTime?
  version          Int       @default(1)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company          RentalCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         AssetCategory           @relation(fields: [categoryId], references: [id])
  brand            AssetBrand?             @relation(fields: [brandId], references: [id])
  units            AssetUnit[]
  rates            AssetRate[]
  rentalPolicy     AssetRentalPolicy?
  locationOptions  AssetLocationOption[]
  blockedIntervals AssetBlockedInterval[]
  auditEvents      AssetAuditEvent[]
  bookings         Booking[]
  reviews          Review[]
  rentalRequests   RentalRequest[]
  inventoryHolds   RentalInventoryHold[]
  reservationLines RentalReservationLine[]
}

model AssetLocationOption {
  id            String  @id @default(cuid())
  listingId     String
  locationId    String
  pickupEnabled Boolean @default(true)
  returnEnabled Boolean @default(true)

  listing  AssetListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  location AssetLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([listingId, locationId])
}

model AssetUnit {
  id              String    @id @default(cuid())
  listingId       String
  assetTag        String    @unique // e.g. "TO-LAP-0001"
  serialNumber    String? // e.g. "SN-ABC-12345"
  locationId      String
  baseStatus      String    @default("ACTIVE") // "ACTIVE" | "MAINTENANCE" | "RETIRED" | "LOST"
  conditionGrade  String    @default("GOOD") // "NEW" | "EXCELLENT" | "GOOD" | "FAIR" | "DAMAGED"
  accessories     String? // "Power Adapter, Sleeve, Mouse"
  conditionPhotos String? // JSON array of URLs
  purchaseDate    DateTime?
  purchaseCost    Float? // Internal only, never exposed to public
  notes           String? // Internal staff notes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  listing          AssetListing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  location         AssetLocation           @relation(fields: [locationId], references: [id])
  blockedIntervals AssetBlockedInterval[]
  bookings         Booking[]
  holdUnits        RentalHoldUnit[]
  unitAllocations  RentalUnitAllocation[]
  handoverItems    RentalHandoverItem[]
  inspectionItems  RentalInspectionItem[]
  maintenanceTasks RentalMaintenanceTask[]
}

model AssetRate {
  id            String    @id @default(cuid())
  listingId     String
  currency      String    @default("USD") // "USD" | "KHR"
  billingUnit   String    @default("DAY") // "HOUR" | "DAY" | "WEEK" | "MONTH"
  rateAmount    Float
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isPrimary     Boolean   @default(true)

  listing AssetListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model AssetRentalPolicy {
  id                       String  @id @default(cuid())
  listingId                String  @unique
  securityDeposit          Float   @default(0)
  minimumDuration          Int     @default(1)
  minimumDurationUnit      String  @default("DAY")
  maximumDuration          Int?
  lateFeeAmount            Float   @default(0)
  lateFeeUnit              String  @default("DAY")
  lateGraceMinutes         Int     @default(30)
  minAdvanceNoticeMinutes  Int     @default(120) // e.g. 2 hours lead time
  preparationBufferMinutes Int     @default(120) // 2 hours prep
  returnBufferMinutes      Int     @default(120) // 2 hours inspection & turnaround
  allowedPickupWeekdays    String? @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\",\"SAT\",\"SUN\"]")
  termsTemplate            String?

  listing AssetListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model AssetBlockedInterval {
  id        String   @id @default(cuid())
  listingId String
  unitId    String? // Null means entire listing is blocked; otherwise specific unit
  startAt   DateTime
  endAt     DateTime
  reason    String // e.g. "Scheduled Maintenance", "Annual Calibration"
  notes     String?
  createdBy String?  @default("Admin")
  createdAt DateTime @default(now())

  listing AssetListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unit    AssetUnit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model AssetAuditEvent {
  id         String   @id @default(cuid())
  companyId  String?
  listingId  String?
  entityType String // "LISTING" | "UNIT" | "RATE" | "POLICY" | "CATEGORY" | "LOCATION"
  entityId   String
  actorName  String   @default("Admin")
  action     String // "CREATE" | "UPDATE" | "PUBLISH" | "UNPUBLISH" | "ARCHIVE" | "MAINTENANCE"
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  company RentalCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listing AssetListing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Booking {
  id         String   @id @default(cuid())
  listingId  String
  unitId     String?
  userId     String
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String   @default("pending") // "pending" | "confirmed" | "cancelled" | "completed"
  createdAt  DateTime @default(now())

  listing AssetListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unit    AssetUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  user    User         @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  rating    Float
  comment   String
  createdAt DateTime @default(now())

  listing AssetListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
}

// ============================================================================
// STEP 03: RENTAL REQUEST & COMMERCIAL SNAPSHOT MODELS
// ============================================================================

model RentalRequest {
  id        String @id @default(cuid())
  requestNo String @unique // e.g. "REQ-2026-000001"
  renterId  String
  listingId String
  companyId String
  status    String @default("PENDING_APPROVAL")
  // Statuses: "DRAFT" | "PENDING_APPROVAL" | "APPROVED_AWAITING_PAYMENT" | "REJECTED" | "CANCELLED_BY_RENTER"

  // Interval & Quantity
  startAt    DateTime
  endAt      DateTime
  rentalDays Int
  quantity   Int      @default(1)

  // Fulfillment
  fulfillment      String  @default("PICKUP") // "PICKUP" | "DELIVERY"
  pickupLocationId String?
  returnLocationId String?

  // Contact Information
  contactName      String
  contactPhone     String
  contactEmail     String
  organizationName String?

  // Customer Notes & Preferences
  customerNotes String?

  // Concurrency & Payment deadline
  version      Int       @default(1)
  paymentDueAt DateTime?

  // Idempotency & Audit
  idempotencyKey String?
  quoteToken     String?
  submittedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  renter            User                     @relation(fields: [renterId], references: [id])
  listing           AssetListing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  company           RentalCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pickupLocation    AssetLocation?           @relation("RequestPickupLoc", fields: [pickupLocationId], references: [id])
  returnLocation    AssetLocation?           @relation("RequestReturnLoc", fields: [returnLocationId], references: [id])
  quoteSnapshot     RentalQuoteSnapshot?
  deliveryAddress   RentalRequestAddress?
  termsAcceptance   RentalTermsAcceptance?
  events            RentalRequestEvent[]
  inventoryHold     RentalInventoryHold?
  approvalDecisions RentalApprovalDecision[]
  changeProposals   RentalChangeProposal[]
  paymentOrder      RentalPaymentOrder?
  depositLedger     RentalDepositLedger?
  reservation       RentalReservation?

  @@index([renterId, status])
  @@index([companyId, status])
  @@index([requestNo])
}

model RentalQuoteSnapshot {
  id                    String   @id @default(cuid())
  requestId             String   @unique
  currency              String   @default("USD")
  billingUnit           String   @default("DAY")
  unitRate              Float
  rentalDays            Int
  quantity              Int      @default(1)
  rentalSubtotal        Float
  securityDeposit       Float    @default(0)
  deliveryFee           Float    @default(0)
  estimatedTax          Float    @default(0)
  totalPayable          Float
  contingentLateFee     Float    @default(0)
  contingentLateFeeUnit String   @default("DAY")
  capturedAt            DateTime @default(now())

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model RentalRequestAddress {
  id             String  @id @default(cuid())
  requestId      String  @unique
  recipientName  String
  recipientPhone String
  addressLine1   String
  addressLine2   String?
  city           String
  postalCode     String?
  deliveryNotes  String?

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model RentalTermsAcceptance {
  id             String   @id @default(cuid())
  requestId      String   @unique
  termsVersionId String   @default("rental-terms-2026.1")
  acceptedAt     DateTime @default(now())
  actorId        String
  ipAddress      String?

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model RentalRequestEvent {
  id         String   @id @default(cuid())
  requestId  String
  actorId    String
  actorName  String
  actorType  String   @default("RENTER") // "RENTER" | "ADMIN" | "SYSTEM"
  action     String // "SUBMIT" | "CANCEL" | "APPROVE" | "REJECT"
  fromStatus String?
  toStatus   String
  reason     String?
  createdAt  DateTime @default(now())

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ============================================================================
// STEP 04: APPROVAL DECISION, INVENTORY HOLD & CHANGE PROPOSAL MODELS
// ============================================================================

model RentalApprovalDecision {
  id             String   @id @default(cuid())
  requestId      String
  reviewerId     String
  reviewerName   String   @default("Admin")
  decision       String // "APPROVE" | "REJECT" | "PROPOSE_CHANGES"
  reasonCode     String? // "INVENTORY_UNAVAILABLE" | "MAINTENANCE_CONFLICT" | "POLICY_VIOLATION" | "APPROVED_STANDARD" | etc.
  publicReason   String? // Visible to customer
  internalNotes  String? // Internal admin notes
  decidedAt      DateTime @default(now())
  requestVersion Int      @default(1)

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RentalInventoryHold {
  id        String   @id @default(cuid())
  requestId String   @unique
  listingId String
  quantity  Int      @default(1)
  startAt   DateTime
  endAt     DateTime
  expiresAt DateTime
  status    String   @default("ACTIVE") // "ACTIVE" | "CONSUMED" | "EXPIRED" | "RELEASED"
  createdBy String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request RentalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listing AssetListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  units   RentalHoldUnit[]

  @@index([listingId, status])
  @@index([expiresAt, status])
}

model RentalHoldUnit {
  id     String @id @default(cuid())
  holdId String
  unitId String

  hold RentalInventoryHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  unit AssetUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([holdId, unitId])
}

model RentalChangeProposal {
  id               String    @id @default(cuid())
  requestId        String
  proposedStartAt  DateTime?
  proposedEndAt    DateTime?
  proposedQuantity Int?
  proposedRate     Float?
  proposedSubtotal Float?
  proposedDeposit  Float?
  proposedTotal    Float?
  reason           String
  status           String    @default("PENDING_RENTER_RESPONSE") // "PENDING_RENTER_RESPONSE" | "ACCEPTED" | "DECLINED"
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ============================================================================
// STEP 05: PAYMENT ORDER, ATTEMPTS, RECEIPTS & DEPOSIT LEDGER MODELS
// ============================================================================

model RentalPaymentOrder {
  id            String    @id @default(cuid())
  requestId     String    @unique
  currency      String    @default("USD")
  rentalAmount  Float
  depositAmount Float     @default(0)
  deliveryFee   Float     @default(0)
  tax           Float     @default(0)
  totalDue      Float
  paymentStatus String    @default("UNPAID") // "UNPAID" | "PROCESSING" | "PAID" | "FAILED" | "EXPIRED" | "REQUIRES_REVIEW"
  dueAt         DateTime
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  request  RentalRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attempts RentalPaymentAttempt[]
  receipt  RentalPaymentReceipt?

  @@index([paymentStatus])
}

model RentalPaymentAttempt {
  id                String   @id @default(cuid())
  paymentOrderId    String
  attemptNo         Int      @default(1)
  method            String // "CARD" | "KHQR" | "BANK_TRANSFER" | "CASH"
  provider          String   @default("SYSTEM_GATEWAY")
  providerReference String?
  status            String   @default("PROCESSING") // "PROCESSING" | "SUCCEEDED" | "FAILED" | "CANCELLED"
  amount            Float
  currency          String   @default("USD")
  idempotencyKey    String?
  failureReason     String?
  createdAt         DateTime @default(now())

  paymentOrder RentalPaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId])
}

model RentalPaymentReceipt {
  id             String   @id @default(cuid())
  paymentOrderId String   @unique
  receiptNo      String   @unique // e.g. "REC-2026-000001"
  rentalAmount   Float
  depositAmount  Float    @default(0)
  deliveryFee    Float    @default(0)
  tax            Float    @default(0)
  totalCaptured  Float
  currency       String   @default("USD")
  paymentMethod  String
  issuedAt       DateTime @default(now())

  paymentOrder RentalPaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
}

model RentalDepositLedger {
  id               String   @id @default(cuid())
  requestId        String   @unique
  currency         String   @default("USD")
  collectedAmount  Float    @default(0)
  heldAmount       Float    @default(0)
  deductedAmount   Float    @default(0)
  refundedAmount   Float    @default(0)
  liabilityBalance Float    @default(0)
  status           String   @default("HELD") // "HELD" | "DEDUCTED" | "REFUNDED" | "SETTLED"
  updatedAt        DateTime @updatedAt

  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ============================================================================
// STEP 06: CONFIRMED RESERVATIONS, UNIT ALLOCATIONS & FULFILLMENT TASKS
// ============================================================================

model RentalReservation {
  id              String   @id @default(cuid())
  bookingNo       String   @unique // e.g. "BK-2026-000001"
  requestId       String   @unique
  renterId        String
  status          String   @default("RESERVED") // "RESERVED" | "READY_FOR_HANDOVER" | "ACTIVE" | "CANCELLED" | "COMPLETED"
  startAt         DateTime
  endAt           DateTime
  locationId      String?
  fulfillmentMode String   @default("PICKUP") // "PICKUP" | "DELIVERY"
  confirmedAt     DateTime @default(now())
  version         Int      @default(1)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  request         RentalRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  renter          User                     @relation(fields: [renterId], references: [id])
  location        AssetLocation?           @relation(fields: [locationId], references: [id])
  lines           RentalReservationLine[]
  fulfillmentTask RentalFulfillmentTask?
  events          RentalReservationEvent[]
  handover        RentalHandover?
  evidence        RentalEvidence[]
  extensions      RentalExtensionRequest[]
  incidents       RentalIncident[]
  returnCase      RentalReturnCase?
  inspection      RentalInspection?
  settlement      RentalSettlement?
  closure         RentalClosure?

  @@index([renterId, status])
  @@index([status, startAt])
  @@index([bookingNo])
}

model RentalReservationLine {
  id              String  @id @default(cuid())
  reservationId   String
  listingId       String
  quantity        Int     @default(1)
  rateSnapshotId  String?
  fulfillmentMode String  @default("PICKUP")

  reservation     RentalReservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  listing         AssetListing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unitAllocations RentalUnitAllocation[]
  poolAllocations RentalPoolAllocation[]

  @@index([reservationId])
  @@index([listingId])
}

model RentalUnitAllocation {
  id                String   @id @default(cuid())
  reservationLineId String
  unitId            String
  startAt           DateTime
  endAt             DateTime
  status            String   @default("COMMITTED") // "COMMITTED" | "RELEASED" | "CHECKED_OUT"
  assignedAt        DateTime @default(now())

  line RentalReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)
  unit AssetUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, startAt, endAt])
  @@index([reservationLineId])
}

model RentalPoolAllocation {
  id                String   @id @default(cuid())
  reservationLineId String
  stockPoolId       String   @default("DEFAULT_POOL")
  quantity          Int      @default(1)
  startAt           DateTime
  endAt             DateTime

  line RentalReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)

  @@index([reservationLineId])
}

model RentalFulfillmentTask {
  id                String    @id @default(cuid())
  reservationId     String    @unique
  pickupAt          DateTime
  locationId        String?
  assignedStaffId   String?   @default("staff-01")
  assignedStaffName String?   @default("Warehouse Operations")
  status            String    @default("SCHEDULED") // "SCHEDULED" | "PREPARING" | "READY_FOR_HANDOVER" | "HANDED_OVER" | "CANCELLED"
  checklistJson     String? // e.g. items, accessories inspection checklist
  notes             String?
  preparedAt        DateTime?
  handedOverAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  location    AssetLocation?    @relation(fields: [locationId], references: [id])

  @@index([status, pickupAt])
}

model RentalReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  actorId       String   @default("SYSTEM")
  actorName     String   @default("Reservation System")
  actorRole     String   @default("SYSTEM") // "SYSTEM" | "ADMIN" | "RENTER"
  action        String // "BOOKING_CONFIRMED" | "MARK_READY" | "REALLOCATE_UNIT" | "CANCEL"
  fromStatus    String
  toStatus      String
  notes         String?
  createdAt     DateTime @default(now())

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// ============================================================================
// STEP 07: HANDOVER, CUSTODY TRANSFER & CONDITION EVIDENCE
// ============================================================================

model RentalHandover {
  id            String   @id @default(cuid())
  reservationId String   @unique
  locationId    String?
  handoverAt    DateTime @default(now())
  staffId       String?  @default("staff-01")
  staffName     String   @default("Warehouse Operations")
  receiverName  String
  signature     String?
  notes         String?
  status        String   @default("COMPLETED") // "COMPLETED" | "NO_SHOW" | "CANCELLED"
  createdAt     DateTime @default(now())

  reservation RentalReservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  items       RentalHandoverItem[]
}

model RentalHandoverItem {
  id              String  @id @default(cuid())
  handoverId      String
  unitId          String
  scannedTag      String
  conditionGrade  String  @default("GOOD")
  functionalCheck String  @default("PASS")
  notes           String?
  accepted        Boolean @default(true)

  handover    RentalHandover            @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  unit        AssetUnit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  accessories RentalHandoverAccessory[]

  @@index([handoverId])
}

model RentalHandoverAccessory {
  id             String  @id @default(cuid())
  handoverItemId String
  name           String
  expectedQty    Int     @default(1)
  actualQty      Int     @default(1)
  condition      String  @default("GOOD")
  notes          String?

  handoverItem RentalHandoverItem @relation(fields: [handoverItemId], references: [id], onDelete: Cascade)

  @@index([handoverItemId])
}

model RentalEvidence {
  id            String   @id @default(cuid())
  reservationId String
  stage         String // "OUT" | "IN"
  mediaUrl      String
  notes         String?
  capturedAt    DateTime @default(now())
  uploadedBy    String   @default("Staff")

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, stage])
}

// ============================================================================
// STEP 08: ACTIVE RENTAL MONITORING, EXTENSIONS & INCIDENTS
// ============================================================================

model RentalExtensionRequest {
  id               String    @id @default(cuid())
  reservationId    String
  requestedEndAt   DateTime
  additionalDays   Int
  additionalCharge Float
  status           String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "PAID_CONFIRMED"
  rejectReason     String?
  requestedAt      DateTime  @default(now())
  decidedAt        DateTime?
  decidedBy        String?

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, status])
}

model RentalIncident {
  id            String    @id @default(cuid())
  reservationId String
  category      String // "MALFUNCTION" | "SAFETY" | "ACCIDENTAL_DAMAGE" | "MISSING_ACCESSORY" | "LOST_STOLEN" | "OTHER"
  severity      String    @default("MEDIUM")
  description   String
  status        String    @default("OPEN") // "OPEN" | "IN_REVIEW" | "RESOLVED"
  reportedAt    DateTime  @default(now())
  resolvedAt    DateTime?
  resolution    String?

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, status])
}

// ============================================================================
// STEP 09: ASSET RETURN & PHYSICAL RECEIPT
// ============================================================================

model RentalReturnCase {
  id                 String    @id @default(cuid())
  reservationId      String    @unique
  requestedBy        String
  returnLocationId   String?
  status             String    @default("SCHEDULED") // "SCHEDULED" | "RECEIVED" | "AWAITING_INSPECTION"
  scheduledAt        DateTime
  actualReceivedAt   DateTime?
  receivingStaffName String?
  discrepancyNotes   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  reservation RentalReservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  receipt     RentalReturnReceipt?
}

model RentalReturnReceipt {
  id                 String   @id @default(cuid())
  returnCaseId       String   @unique
  receiptNo          String   @unique // e.g. "RET-2026-000001"
  receivedAt         DateTime @default(now())
  receivingStaffName String   @default("Warehouse Receiving")
  locationName       String   @default("Main Logistics Facility")
  totalUnitsReceived Int      @default(1)
  notes              String?

  returnCase RentalReturnCase @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)
}

// ============================================================================
// STEP 10: RETURN INSPECTION & DEPOSIT SETTLEMENT
// ============================================================================

model RentalInspection {
  id            String    @id @default(cuid())
  reservationId String    @unique
  inspectorName String    @default("Technical Quality Inspector")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  verdict       String    @default("PASS") // "PASS" | "CLEANING_REQUIRED" | "REPAIR_REQUIRED" | "DAMAGED" | "MISSING"
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reservation RentalReservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  items       RentalInspectionItem[]
}

model RentalInspectionItem {
  id                  String  @id @default(cuid())
  inspectionId        String
  unitId              String
  conditionGrade      String  @default("GOOD")
  functionalResult    String  @default("PASS")
  verdict             String  @default("PASS")
  disposition         String  @default("AVAILABLE") // "AVAILABLE" | "MAINTENANCE" | "LOST" | "RETIRED"
  damageNotes         String?
  estimatedRepairCost Float   @default(0)

  inspection RentalInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  unit       AssetUnit        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model RentalSettlement {
  id                  String    @id @default(cuid())
  reservationId       String    @unique
  currency            String    @default("USD")
  rentalAmount        Float
  depositHeld         Float     @default(0)
  lateFee             Float     @default(0)
  damageFee           Float     @default(0)
  missingItemsFee     Float     @default(0)
  cleaningFee         Float     @default(0)
  totalDeductions     Float     @default(0)
  netRefundAmount     Float     @default(0)
  additionalDueAmount Float     @default(0)
  status              String    @default("PENDING") // "PENDING" | "APPROVED" | "REFUNDED" | "SETTLED"
  approvedBy          String?
  approvedAt          DateTime?
  refundedAt          DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// STEP 11: CLOSURE & INVENTORY DISPOSITION
// ============================================================================

model RentalClosure {
  id            String   @id @default(cuid())
  reservationId String   @unique
  closedAt      DateTime @default(now())
  closedBy      String   @default("System / Admin Finance")
  closureType   String   @default("NORMAL") // "NORMAL" | "CLOSED_WITH_BALANCE" | "CLOSED_WITH_DISPUTE"
  finalStatus   String   @default("COMPLETED")
  summaryJson   String?
  notes         String?

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model RentalMaintenanceTask {
  id               String    @id @default(cuid())
  unitId           String
  reservationId    String?
  issueDescription String
  priority         String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  status           String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  unit AssetUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, status])
}
